#!/usr/bin/env python3
"""sketchnote: CLI entry point.

    sketchnote service       run the D-Bus service (normally started by D-Bus activation)
    sketchnote latest        print the latest bundle's path
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from service import CAPTURES, run  # noqa: E402


def latest():
    """Newest bundle that has finished building, or None."""
    if not os.path.isdir(CAPTURES):
        return None
    for name in sorted(os.listdir(CAPTURES), reverse=True):
        path = os.path.join(CAPTURES, name)
        if os.path.exists(os.path.join(path, 'summary.md')):
            return path
    return None


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ''
    if cmd == 'service':
        run()
    elif cmd == 'latest':
        print(latest() or '')
    else:
        print(__doc__.strip())
        sys.exit(2)


if __name__ == '__main__':
    main()
