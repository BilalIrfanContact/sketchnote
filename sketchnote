#!/usr/bin/env python3
"""sketchnote: CLI entry point.

    sketchnote service       run the D-Bus service (normally started by D-Bus activation)
    sketchnote paste-text    copy the latest bundle's summary.md to the clipboard
    sketchnote paste-image   copy the latest bundle's contact-sheet.png to the clipboard
    sketchnote latest        print the latest bundle's path
"""
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from service import CAPTURES, notify, run  # noqa: E402


def latest():
    """Newest bundle that has finished building, or None."""
    if not os.path.isdir(CAPTURES):
        return None
    for name in sorted(os.listdir(CAPTURES), reverse=True):
        path = os.path.join(CAPTURES, name)
        if os.path.exists(os.path.join(path, 'summary.md')):
            return path
    return None


def copy(filename, mime):
    path = latest()
    if not path:
        notify('Sketchnote', 'No finished capture yet')
        sys.exit(1)
    with open(os.path.join(path, filename), 'rb') as f:
        subprocess.run(['wl-copy', '--type', mime], stdin=f, check=True)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ''
    if cmd == 'service':
        run()
    elif cmd == 'paste-text':
        copy('summary.md', 'text/plain;charset=utf-8')
    elif cmd == 'paste-image':
        copy('contact-sheet.png', 'image/png')
    elif cmd == 'latest':
        print(latest() or '')
    else:
        print(__doc__.strip())
        sys.exit(2)


if __name__ == '__main__':
    main()
